<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <staticContent>
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
        </staticContent>
        <rewrite>
            <outboundRules>
                <rule name="Cache Control for static files">
                    <match serverVariable="RESPONSE_Cache-Control" pattern=".*" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" pattern="\.(css|js|woff2|jpg|jpeg|png|gif|svg)$" />
                    </conditions>
                    <action type="Rewrite" value="public, max-age=2592000" />
                </rule>
            </outboundRules>
        </rewrite>
    </system.webServer>
</configuration>